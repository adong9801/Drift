{
  "manifest_version": 3,
  "name": "Type Along",
  "short_name": "Type Along",
  "version": "1.0",
  "description": "Paste in text you want to type. The next words show in grey where you type, and it keeps your place as you go.",
  "action": {
    "default_title": "Type Along",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
